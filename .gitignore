site/
.zenforge/
# Binaries left by `go build ./examples/<name>/` run from the repository root.
# The leading slash keeps these anchored to the root, so the example
# directories themselves are never ignored.
/qa-agent
/long-task-agent
/coding-agent

# The benchmark's Python runners are installed into a virtualenv on demand.
/benchmarks/.venv/

# The Python runners create bytecode caches when they run.
__pycache__/
